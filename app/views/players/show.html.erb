<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1 class="mb-1"><%= @player.name %></h1>
    <div class="text-muted">Player</div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_player_path(@player), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete",
                  player_path(@player),
                  method: :delete,
                  data: { turbo_confirm: "Delete #{@player.name}?" },
                  class: "btn btn-outline-danger" %>
  </div>
</div>

<dl class="row">
  <dt class="col-sm-3">First name</dt>
  <dd class="col-sm-9"><%= @player.first_name %></dd>
  <dt class="col-sm-3">Last name</dt>
  <dd class="col-sm-9"><%= @player.last_name %></dd>
  <dt class="col-sm-3">Country</dt>
  <dd class="col-sm-9"><%= @player&.country&.name %></dd>
</dl>

<%= link_to "Back to players", players_path, class: "btn btn-link px-0" %>

