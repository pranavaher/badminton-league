<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Matches</h1>
  <%= link_to 'New Match', new_match_path, class: 'btn btn-primary' %>
</div>

<% if @matches.any? %>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Date</th>
          <th>Player A</th>
          <th>Player B</th>
          <th>Result</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @matches.each do |m| %>
          <tr>
            <td><%= m.name.presence || "Match ##{m.id}" %></td>
            <td><%= l m.created_at, format: :short %></td>
            <td><%= link_to m.player_a.name, player_path(m.player_a) %></td>
            <td><%= link_to m.player_b.name, player_path(m.player_b) %></td>
            <td>
              <% if m.winner.present? %>
                <span class="badge bg-success"><%= m.winner.name %></span>
              <% else %>
                <div class="btn-group" role="group">
                  <%= button_to 'Mark A as winner', decide_match_path(m, winner: 'a'), method: :post, class: 'btn btn-sm btn-outline-primary' %>
                  <%= button_to 'Mark B as winner', decide_match_path(m, winner: 'b'), method: :post, class: 'btn btn-sm btn-outline-primary' %>
                </div>
              <% end %>
            </td>
            <td class="text-end">
              <% if m.winner.blank? %>
                <%= link_to 'Edit', edit_match_path(m), class: 'btn btn-sm btn-outline-secondary' %>
              <% end %>
              <%= button_to 'Delete', match_path(m), method: :delete, form: { data: { turbo_confirm: 'Delete this match?' }, class: 'd-inline' }, class: 'btn btn-sm btn-outline-danger ms-2' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-light border">No matches recorded yet.</div>
<% end %>
