<h1>Match</h1>

<p>
  <strong>Winner:</strong>
  <% if @match.winner.present? %>
    <%= link_to @match.winner.name, player_path(@match.winner) %>
  <% else %>
    <em>Not decided</em>
  <% end %>
</p>

<p>
  <strong>Loser:</strong>
  <% if @match.loser.present? %>
    <%= link_to @match.loser.name, player_path(@match.loser) %>
  <% else %>
    <em>Not decided</em>
  <% end %>
</p>

<p>
  <strong>Recorded at:</strong>
  <%= l @match.created_at %>
</p>

<% if @match.winner.blank? %>
  <%= link_to 'Edit', edit_match_path(@match), class: 'btn btn-secondary' %>
<% end %>
<%= link_to 'Back', matches_path, class: 'btn btn-link' %>
